{
  "name": "aispanda-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run validate:profile && pnpm run validate:content && astro build && node scripts/validate-content-boundary.mjs dist",
    "preview": "astro preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:ai": "node --test tests/ai-connections.test.ts tests/ai-vault-core.test.mjs",
    "validate:profile": "node scripts/validate-site-profile.mjs",
    "validate:content": "node scripts/validate-content-boundary.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.5.0"
  },
  "devDependencies": {
    "@storybook-astro/framework": "^1.10.0",
    "@storybook/builder-vite": "^10.5.8",
    "storybook": "^10.5.8"
  }
}
