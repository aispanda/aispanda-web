rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Provider credentials are encrypted and accessed only through the Cloud Run
    // service identity. Browser SDK clients must never read or write this vault.
    match /aiCredentialVault/{userId}/{document=**} {
      allow read, write: if false;
    }
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function accessPath() {
      return /databases/$(database)/documents/studioAccess/$(request.auth.uid);
    }

    function invitePath() {
      return /databases/$(database)/documents/studioInvites/$(request.auth.token.email);
    }

    function hasStudioAccess() {
      return signedIn()
        && exists(accessPath())
        && get(accessPath()).data.active == true;
    }

    function isAdministrator() {
      return hasStudioAccess() && get(accessPath()).data.role == 'administrator';
    }

    function isAuthor() {
      return hasStudioAccess() && get(accessPath()).data.role == 'author';
    }

    function isPublisher() {
      return hasStudioAccess() && get(accessPath()).data.role == 'publisher';
    }

    function canComment() {
      return hasStudioAccess()
        && get(accessPath()).data.role in [
          'administrator', 'publisher', 'author', 'commenter'
        ];
    }

    function profilePath() {
      return /databases/$(database)/documents/userProfiles/$(request.auth.uid);
    }

    function commentPath(slug, commentId) {
      return /databases/$(database)/documents/publishedContent/$(slug)/comments/$(commentId);
    }

    function commentOwnerPath(slug, commentId) {
      return /databases/$(database)/documents/publishedContent/$(slug)/commentOwners/$(commentId);
    }

    function commentLikePath(slug, commentId) {
      return /databases/$(database)/documents/publishedContent/$(slug)/commentLikes/$(commentId + '_' + request.auth.uid);
    }

    function canPinComments() {
      return hasStudioAccess()
        && get(accessPath()).data.role in ['administrator', 'publisher'];
    }

    function validNewComment(slug, commentId) {
      return canComment()
        && exists(profilePath())
        && request.resource.data.keys().hasOnly([
          'articleSlug', 'parentId', 'body', 'authorName',
          'createdAt', 'updatedAt', 'edited', 'deleted', 'deletedAt',
          'likeCount', 'pinned', 'pinnedAt'
        ])
        && request.resource.data.articleSlug == slug
        && request.resource.data.parentId is string
        && request.resource.data.parentId.size() <= 128
        && (
          request.resource.data.parentId == ''
          || (
            exists(commentPath(slug, request.resource.data.parentId))
            && get(commentPath(slug, request.resource.data.parentId)).data.parentId == ''
          )
        )
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 5000
        && request.resource.data.authorName == get(profilePath()).data.displayName
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 200
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.edited == false
        && request.resource.data.deleted == false
        && request.resource.data.deletedAt == null
        && request.resource.data.likeCount == 0
        && request.resource.data.pinned == false
        && request.resource.data.pinnedAt == null
        && existsAfter(commentOwnerPath(slug, commentId))
        && getAfter(commentOwnerPath(slug, commentId)).data.authorUid == request.auth.uid
        && getAfter(commentOwnerPath(slug, commentId)).data.commentId == commentId
        && getAfter(commentOwnerPath(slug, commentId)).data.createdAt == request.time;
    }

    function preservesCommentIdentity() {
      return request.resource.data.articleSlug == resource.data.articleSlug
        && request.resource.data.parentId == resource.data.parentId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validOwnCommentEdit(slug, commentId) {
      return get(commentOwnerPath(slug, commentId)).data.authorUid == request.auth.uid
        && resource.data.deleted == false
        && request.resource.data.deleted == false
        && request.resource.data.deletedAt == null
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 5000
        && request.resource.data.edited == true
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'body', 'edited', 'updatedAt'
        ]);
    }

    function validCommentDeletion() {
      return resource.data.deleted == false
        && request.resource.data.deleted == true
        && request.resource.data.body == ''
        && request.resource.data.deletedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.pinned == false
        && request.resource.data.pinnedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'body', 'deleted', 'deletedAt', 'updatedAt', 'pinned', 'pinnedAt'
        ]);
    }

    function validLikeChange(slug, commentId) {
      return resource.data.deleted == false
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && (
          (
            request.resource.data.likeCount == resource.data.likeCount + 1
            && !exists(commentLikePath(slug, commentId))
            && existsAfter(commentLikePath(slug, commentId))
          )
          || (
            request.resource.data.likeCount == resource.data.likeCount - 1
            && exists(commentLikePath(slug, commentId))
            && !existsAfter(commentLikePath(slug, commentId))
          )
        );
    }

    function validPinChange() {
      return canPinComments()
        && resource.data.deleted == false
        && resource.data.parentId == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'pinnedAt'])
        && (
          (
            request.resource.data.pinned == true
            && request.resource.data.pinnedAt == request.time
          )
          || (
            request.resource.data.pinned == false
            && request.resource.data.pinnedAt == null
          )
        );
    }

    function validDraft() {
      return request.resource.data.keys().hasOnly([
          'title', 'body', 'excerpt', 'slug', 'tags', 'publicationStatus',
          'updatedAt', 'revisions', 'ownerUid', 'ownerEmail',
          'publicationReleaseId', 'publicationLiveUrl'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 300
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 500000
        && request.resource.data.excerpt is string
        && request.resource.data.excerpt.size() <= 2000
        && request.resource.data.slug is string
        && request.resource.data.slug.size() <= 90
        && request.resource.data.tags is string
        && request.resource.data.tags.size() <= 1000
        && request.resource.data.publicationStatus in [
          'draft', 'published', 'published-with-changes', 'unpublished'
        ]
        && request.resource.data.updatedAt is string
        && request.resource.data.revisions is list
        && request.resource.data.revisions.size() <= 20
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerEmail is string
        && request.resource.data.get('publicationReleaseId', '') is string
        && request.resource.data.get('publicationLiveUrl', '') is string;
    }

    function validProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'providerIds', 'professionalRole',
          'primaryInterest', 'countryCode', 'profileCompletedAt',
          'firstSeenAt', 'lastSeenAt', 'privacyNoticeVersion'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 200
        && request.resource.data.providerIds is list
        && request.resource.data.providerIds.size() <= 10
        && request.resource.data.professionalRole in [
          'prefer-not-to-say', 'student', 'educator-researcher',
          'technology-ai-practitioner', 'business-operations-leader',
          'public-sector-policy', 'writer-creator', 'independent-learner', 'other'
        ]
        && request.resource.data.primaryInterest in [
          'prefer-not-to-say', 'practical-ai', 'ai-strategy',
          'open-reusable-ai', 'ai-policy-social-impact',
          'education-training', 'community-discussion', 'other'
        ]
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.size() <= 2
        && request.resource.data.profileCompletedAt is string
        && request.resource.data.firstSeenAt is string
        && request.resource.data.lastSeenAt is string
        && request.resource.data.privacyNoticeVersion is string;
    }

    match /studioAccess/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['active', 'role', 'email', 'claimedAt'])
        && request.resource.data.active == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in [
          'administrator', 'publisher', 'author', 'commenter', 'viewer'
        ]
        && (
          request.resource.data.role == 'commenter'
          || (
            exists(invitePath())
            && get(invitePath()).data.active == true
            && request.resource.data.role == get(invitePath()).data.role
          )
        );
      allow update: if isAdministrator()
        && request.resource.data.keys().hasOnly([
          'active', 'role', 'email', 'claimedAt', 'approvedAt', 'approvedBy'
        ])
        && request.resource.data.active is bool
        && request.resource.data.email == resource.data.email
        && request.resource.data.claimedAt == resource.data.claimedAt
        && request.resource.data.role in [
          'administrator', 'publisher', 'author', 'commenter', 'viewer'
        ];
      allow delete: if false;
    }

    match /studioInvites/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow write: if false;
    }

    match /userProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdministrator());
      allow create: if signedIn() && validProfile(uid);
      allow update: if signedIn()
        && validProfile(uid)
        && request.resource.data.firstSeenAt == resource.data.firstSeenAt;
      allow delete: if false;
    }

    match /roleRequests/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdministrator());
      allow create: if signedIn()
        && request.auth.uid == uid
        && hasStudioAccess()
        && get(accessPath()).data.role in ['commenter', 'viewer']
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'currentRole', 'requestedRole', 'status',
          'createdAt', 'reviewedAt', 'reviewedBy', 'lastCancelledAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.currentRole == get(accessPath()).data.role
        && request.resource.data.requestedRole in ['author', 'publisher', 'administrator']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is string
        && request.resource.data.reviewedAt == ''
        && request.resource.data.reviewedBy == ''
        && request.resource.data.lastCancelledAt == '';
      allow update: if (
          request.auth.uid == uid
          && hasStudioAccess()
          && get(accessPath()).data.role in ['commenter', 'viewer']
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'lastCancelledAt'
          ])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.lastCancelledAt is string
          && request.resource.data.lastCancelledAt != ''
        ) || (
          request.auth.uid == uid
          && hasStudioAccess()
          && get(accessPath()).data.role in ['commenter', 'viewer']
          && resource.data.status in ['denied', 'cancelled']
          && request.resource.data.keys().hasOnly([
            'uid', 'email', 'currentRole', 'requestedRole', 'status',
            'createdAt', 'reviewedAt', 'reviewedBy', 'lastCancelledAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.currentRole == get(accessPath()).data.role
          && request.resource.data.requestedRole in ['author', 'publisher', 'administrator']
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt is string
          && request.resource.data.reviewedAt == ''
          && request.resource.data.reviewedBy == ''
          && request.resource.data.lastCancelledAt is string
          && request.resource.data.lastCancelledAt == resource.data.get('lastCancelledAt', '')
        ) || (
          isAdministrator()
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reviewedAt', 'reviewedBy'
          ])
          && request.resource.data.status in ['approved', 'denied']
          && request.resource.data.reviewedAt is string
          && request.resource.data.reviewedBy == request.auth.uid
        );
      allow delete: if false;
    }

    match /contentDrafts/{draftId} {
      allow read: if isAdministrator() || isPublisher()
        || (isAuthor() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /publishedContent/{slug} {
      allow read, write: if false;
    }

    match /contentPublicationIndex/{draftId} {
      allow read, write: if false;
    }

    match /contentPublicationRequests/{requestId} {
      allow read, write: if false;
    }

    match /contentPreviewReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /contentReleases/{releaseId} {
      allow read, write: if false;
    }

    match /contentReleasePayloads/{payloadId} {
      allow read, write: if false;
    }

    match /contentAuditEvents/{eventId} {
      allow read, write: if false;
    }

    match /contentAssets/{assetId} {
      allow read, write: if false;
    }

    match /contentAssetPublicRefs/{assetId} {
      allow read, write: if false;
    }

    match /publishedContent/{slug}/comments/{commentId} {
      allow read: if true;
      allow create: if validNewComment(slug, commentId);
      allow update: if canComment()
        && preservesCommentIdentity()
        && (
          validOwnCommentEdit(slug, commentId)
          || validLikeChange(slug, commentId)
          || validPinChange()
          || (
            validCommentDeletion()
            && (
              get(commentOwnerPath(slug, commentId)).data.authorUid == request.auth.uid
              || isAdministrator()
            )
          )
        );
      allow delete: if false;
    }

    match /publishedContent/{slug}/commentOwners/{commentId} {
      allow read: if signedIn()
        && (resource.data.authorUid == request.auth.uid || isAdministrator());
      allow create: if canComment()
        && request.resource.data.keys().hasOnly(['commentId', 'authorUid', 'createdAt'])
        && request.resource.data.commentId == commentId
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(commentPath(slug, commentId))
        && getAfter(commentPath(slug, commentId)).data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /publishedContent/{slug}/commentLikes/{likeId} {
      allow read: if signedIn()
        && (resource.data.userUid == request.auth.uid || isAdministrator());
      allow create: if canComment()
        && request.resource.data.keys().hasOnly(['commentId', 'userUid', 'createdAt'])
        && likeId == request.resource.data.commentId + '_' + request.auth.uid
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && exists(commentPath(slug, request.resource.data.commentId))
        && getAfter(commentPath(slug, request.resource.data.commentId)).data.likeCount
          == get(commentPath(slug, request.resource.data.commentId)).data.likeCount + 1;
      allow update: if false;
      allow delete: if canComment()
        && resource.data.userUid == request.auth.uid
        && likeId == resource.data.commentId + '_' + request.auth.uid
        && getAfter(commentPath(slug, resource.data.commentId)).data.likeCount
          == get(commentPath(slug, resource.data.commentId)).data.likeCount - 1;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
