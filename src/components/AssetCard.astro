---
interface Props {
  asset: {
    id: string;
    name: string;
    type: string;
    status: string;
    summary: string;
    outcome: string;
    href: string;
    tags: string[];
  };
  featured?: boolean;
}
const { asset, featured = false } = Astro.props;
---

<article class:list={['asset-card', { featured }]} id={asset.id}>
  <div class="asset-meta"><span>{asset.type}</span><span class="status-dot">{asset.status}</span></div>
  <h3>{asset.name}</h3>
  <p>{asset.summary}</p>
  <p class="asset-outcome"><strong>Why it matters:</strong> {asset.outcome}</p>
  <div class="tag-list">{asset.tags.map((tag) => <span>{tag}</span>)}</div>
  <a class="text-link" href={asset.href}>Explore asset <span aria-hidden="true">→</span></a>
</article>
