---
import BrandMark from '@/components/BrandMark.astro';
import { navigation } from '@/data/site';
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="AI Spanda home">
      <BrandMark size={64} ground="light" />
      <span class="brand-wordmark">AI <span>Spanda</span></span>
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-navigation">Menu</button>
    <nav id="site-navigation" class="site-navigation" aria-label="Primary">
      {navigation.map((item) => (
        <a href={item.href} aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href="/account" data-staff-signin>Sign in</a>
      <a href="/account" data-member-entry hidden>My account</a>
      <a href="/ai" data-ai-tools-entry hidden>AI Tools</a>
      <a href="/my-articles" data-studio-entry hidden>My articles</a>
      <a href="/topics">Collections</a>
      <a href="/review" data-review-entry hidden>Review submissions</a>
      <a href="/manage/collections" data-admin-entry hidden>Manage collections</a>
      <a href="/manage/users" data-admin-entry hidden>Manage users</a>
      <a class="button button-small" href="/contact">Write</a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const nav = document.querySelector<HTMLElement>('.site-navigation');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    nav?.toggleAttribute('data-open', !open);
  });

  const sessionKey = 'blog-studio-authorized-session-v1';
  const memberSessionKey = 'blog-member-session-v1';
  const staffSignIn = document.querySelector<HTMLElement>('[data-staff-signin]');
  const memberEntry = document.querySelector<HTMLElement>('[data-member-entry]');
  const aiToolsEntry = document.querySelector<HTMLElement>('[data-ai-tools-entry]');
  const studioEntry = document.querySelector<HTMLElement>('[data-studio-entry]');
  const refreshStudioNavigation = () => {
    let authorized = false;
    let signedIn = false;
    let role = '';
    try {
      const session = JSON.parse(window.localStorage.getItem(sessionKey) ?? '{}') as { role?: string; expiresAt?: number };
      authorized = ['administrator', 'publisher', 'author'].includes(session.role ?? '')
        && Number(session.expiresAt) > Date.now();
      const memberSession = JSON.parse(window.localStorage.getItem(memberSessionKey) ?? '{}') as { role?: string; expiresAt?: number };
      signedIn = ['administrator', 'publisher', 'author', 'commenter', 'viewer'].includes(memberSession.role ?? '')
        && Number(memberSession.expiresAt) > Date.now();
      role = signedIn ? memberSession.role ?? '' : '';
    } catch {
      authorized = false;
      signedIn = false;
    }
    if (staffSignIn) staffSignIn.hidden = authorized || signedIn;
    if (memberEntry) memberEntry.hidden = !signedIn;
    if (aiToolsEntry) aiToolsEntry.hidden = !signedIn;
    if (studioEntry) studioEntry.hidden = !authorized;
    document.querySelectorAll<HTMLElement>('[data-admin-entry]').forEach(link => { link.hidden = role !== 'administrator'; });
    const reviewEntry = document.querySelector<HTMLElement>('[data-review-entry]');
    if (reviewEntry) reviewEntry.hidden = !['administrator', 'publisher'].includes(role);
  };
  refreshStudioNavigation();
  window.addEventListener('storage', (event) => {
    if (event.key === sessionKey || event.key === memberSessionKey) refreshStudioNavigation();
  });
</script>
