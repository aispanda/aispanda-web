---
interface Props {
  size?: number;
  /** Light chrome uses the white-ground mark so spectrum rings read clearly. */
  ground?: 'light' | 'dark';
  class?: string;
}

const { size = 52, ground = 'light', class: className = '' } = Astro.props;
const src = ground === 'dark' ? '/brand/mark-color-on-black.png' : '/brand/mark-color-on-white.png';
---

<span class={`brand-mark-frame ${className}`} style={`width:${size}px;height:${size}px`}>
  <img
    class="brand-mark-img"
    src={src}
    width={size}
    height={size}
    alt=""
    decoding="async"
  />
</span>
