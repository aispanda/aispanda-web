---
import { footerNavigation } from '@/data/site';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <p class="brand footer-brand">AI<span>spanda</span></p>
      <p>Practical AI thinking, reusable systems, and working proof.</p>
    </div>
    <nav aria-label="Footer">
      {footerNavigation.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="footer-meta">
      <p>Built openly. Improved continuously.</p>
      <p>© {new Date().getFullYear()} AIspanda</p>
    </div>
  </div>
</footer>
