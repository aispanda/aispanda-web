---
import BrandMark from '@/components/BrandMark.astro';
import { footerNavigation } from '@/data/site';
---

<footer class="site-footer">
  <div class="footer-motif" aria-hidden="true"></div>
  <div class="shell footer-grid">
    <div>
      <p class="brand footer-brand">
        <BrandMark size={56} ground="light" />
        <span class="brand-wordmark">AI <span>Spanda</span></span>
      </p>
      <p>Personal writing on AI, agency, and workable paths — not a firm, nothing for sale here.</p>
    </div>
    <nav aria-label="Footer">
      {footerNavigation.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="footer-meta">
      <p>Built in the open. Improved continuously.</p>
      <p>© {new Date().getFullYear()} AI Spanda</p>
    </div>
  </div>
</footer>
