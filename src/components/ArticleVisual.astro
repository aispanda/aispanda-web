---
interface Props {
  art: { src: string; alt: string };
  summary: string;
}
const { art, summary } = Astro.props;
const small = art.src.replace(/\.webp$/, '-small.webp');
---
<figure class="article-visual">
  <img src={art.src} srcset={`${small} 600w, ${art.src} 1200w`}
    sizes="(max-width: 640px) 100vw, 900px" width="1200" height="800"
    alt={art.alt} loading="lazy" decoding="async" />
  <figcaption>{summary} <span>AI-generated conceptual illustration.</span></figcaption>
</figure>
<style>
  .article-visual { margin: 0 0 2.5rem; }
  .article-visual img { display: block; width: 100%; height: auto; border-radius: 12px; }
  .article-visual figcaption { margin-top: .75rem; font-size: .95rem; line-height: 1.6; color: var(--muted, #505968); }
  .article-visual figcaption span { display: block; font-size: .85rem; margin-top: .25rem; }
</style>
