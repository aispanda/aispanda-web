---
import '@/styles/global.css';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('insights', 'open-the-ai');

if (!entry) {
  throw new Error('Missing seed insight body for Content Studio');
}

const { Content } = await render(entry);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Content Studio · AI Spanda</title>
    <link rel="icon" type="image/png" href="/brand/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@550;650;700&family=Source+Sans+3:ital,wght@0,450;0,650;0,750;1,450&display=swap"
    />
  </head>
  <body class="studio-page">
    <section class="studio-access-gate" data-access-gate aria-labelledby="studio-access-title">
      <div class="studio-access-card">
        <a class="studio-access-brand" href="/" aria-label="AI Spanda home">
          <img src="/brand/favicon.png" width="46" height="46" alt="" />
          <span>AI <strong>Spanda</strong></span>
        </a>
        <p class="studio-kicker">Private content workspace</p>
        <h1 id="studio-access-title" data-access-title>Checking access…</h1>
        <p data-access-message>Confirming whether Content Studio is connected and ready.</p>
        <div class="studio-access-actions">
          <button class="studio-google-button" type="button" data-google-signin hidden>
            <span aria-hidden="true">G</span>
            Continue with Google
          </button>
          <button class="studio-button studio-button-secondary" type="button" data-access-retry hidden>Use another account</button>
        </div>
        <form class="studio-profile-form" data-profile-form hidden>
          <p>Signed in as <strong data-profile-email></strong></p>
          <label>
            <span>Professional role</span>
            <select data-profile-professional-role>
              <option value="prefer-not-to-say">Prefer not to say</option>
              <option value="student">Student</option>
              <option value="educator-researcher">Educator or researcher</option>
              <option value="technology-ai-practitioner">Technology or AI practitioner</option>
              <option value="business-operations-leader">Business or operations leader</option>
              <option value="public-sector-policy">Public sector or policy</option>
              <option value="writer-creator">Writer or creator</option>
              <option value="independent-learner">Independent learner</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label>
            <span>Primary interest</span>
            <select data-profile-primary-interest>
              <option value="prefer-not-to-say">Prefer not to say</option>
              <option value="practical-ai">Practical AI use</option>
              <option value="ai-strategy">AI strategy and leadership</option>
              <option value="open-reusable-ai">Open and reusable AI</option>
              <option value="ai-policy-social-impact">AI policy and social impact</option>
              <option value="education-training">Education and training</option>
              <option value="community-discussion">Community and discussion</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label>
            <span>Country or area</span>
            <select data-profile-country>
              <option value="">Prefer not to say</option>
            </select>
          </label>
          <small>These choices help us understand our community. They do not change your account permissions.</small>
          <button class="studio-button" type="submit" data-profile-submit>Continue</button>
          <small role="status" aria-live="polite" data-profile-status></small>
        </form>
        <div class="studio-role-request" data-role-request-panel hidden>
          <p>Signed in as <strong data-role-request-email></strong></p>
          <label>
            <span>Request editorial access</span>
            <select data-role-request-select>
              <option value="author">Author</option>
              <option value="publisher">Publisher</option>
              <option value="administrator">Administrator</option>
            </select>
          </label>
          <div class="studio-role-request-actions">
            <button class="studio-button" type="button" data-role-request-submit>Send request</button>
            <button class="studio-button studio-button-secondary" type="button" data-role-request-cancel hidden>Cancel request</button>
          </div>
          <small role="status" aria-live="polite" data-role-request-status>Only an existing administrator can approve this request.</small>
        </div>
        <a class="studio-button studio-button-secondary studio-back-home" href="/">Back to AI Spanda</a>
        <small>New accounts start as Commenters. Editorial access requires Administrator approval.</small>
      </div>
    </section>

    <main class="studio" data-studio hidden>
      <aside class="studio-sidebar" aria-label="Content navigation">
        <a class="studio-brand" href="/" aria-label="AI Spanda home">
          <img src="/brand/favicon.png" width="36" height="36" alt="" />
          <span>AI <strong>Spanda</strong></span>
        </a>

        <button class="studio-new-article" type="button" data-new-article>
          <span aria-hidden="true">＋</span> New article
        </button>

        <div>
          <p class="studio-kicker">Content</p>
          <nav class="studio-nav">
            <button class="is-active" type="button" data-filter="all"><span>All content</span><small data-all-count>1</small></button>
            <button type="button" data-filter="draft"><span>Drafts</span><small data-draft-count>0</small></button>
            <button type="button" data-filter="published"><span>Published</span><small data-published-count>1</small></button>
            <button type="button" data-filter="unpublished"><span>Unpublished</span><small data-unpublished-count>0</small></button>
            <button type="button" data-filter="archived"><span>Archived</span><small data-archived-count>0</small></button>
            <button type="button" disabled title="Book workspace comes after the article MVP">
              <span>Books</span><small>Next</small>
            </button>
          </nav>
        </div>

        <div class="studio-document-list">
          <p class="studio-kicker" data-list-heading>All content</p>
          <div class="studio-document-items" data-document-list>
            <div class="studio-document is-active">
              <a class="studio-document-title" href="/open-the-ai">{entry.data.title}</a>
              <div><small>Published</small><a class="studio-document-edit" href="/studio">Edit</a></div>
            </div>
          </div>
        </div>

        <div class="studio-sidebar-note">
          <strong>Cloud publishing</strong>
          <span data-persistence-note>Drafts save to your account and publish directly to the site.</span>
        </div>

        <div class="studio-account" data-studio-account hidden>
          <span>Signed in as</span>
          <strong data-studio-account-email></strong>
          <span class="studio-account-role" data-studio-account-role></span>
          <a href="/account">Account settings</a>
          <button type="button" data-manage-access hidden>Access requests</button>
          <button type="button" data-studio-signout>Sign out</button>
        </div>
      </aside>

      <section class="studio-workspace">
        <header class="studio-topbar">
          <details class="studio-mobile-nav">
            <summary aria-label="Open content navigation">☰</summary>
            <nav aria-label="Mobile content navigation">
              <button type="button" data-filter="all">All content</button>
              <button type="button" data-filter="draft">Drafts</button>
              <button type="button" data-filter="published">Published</button>
              <button type="button" data-filter="unpublished">Unpublished</button>
              <button type="button" data-filter="archived">Archived</button>
              <button type="button" data-new-article>New article</button>
              <a href="/account">Account settings</a>
              <button type="button" data-studio-signout>Sign out</button>
            </nav>
          </details>
          <div>
            <p class="studio-kicker" data-topbar-kicker>Article</p>
            <p class="studio-save-state" role="status" aria-live="polite" data-save-state>Draft · ready</p>
          </div>

          <div class="studio-actions" data-editor-actions>
            <button class="studio-button studio-button-secondary" type="button" data-open-ai>AI assist</button>
            <button class="studio-button studio-button-secondary" type="button" data-preview>Preview</button>
            <details class="studio-save-menu" data-save-menu>
              <summary class="studio-button">Save <span aria-hidden="true">⌄</span></summary>
              <div class="studio-save-options">
                <button type="button" data-save-draft>
                  <strong>Save as draft</strong>
                  <span>Create a revision checkpoint</span>
                </button>
                <button type="button" data-open-publish>
                  <strong>Publish</strong>
                  <span>Review before publishing</span>
                </button>
              </div>
            </details>
          </div>
        </header>

        <div class="studio-grid" data-editor-workspace>
          <section class="studio-editor-column" aria-label="Article editor">
            <div class="studio-toolbar" role="toolbar" aria-label="Text formatting">
              <button type="button" data-command="bold" title="Bold"><strong>B</strong></button>
              <button type="button" data-command="italic" title="Italic"><em>I</em></button>
              <span aria-hidden="true"></span>
              <button type="button" data-block="h2">H2</button>
              <button type="button" data-block="h3">H3</button>
              <button type="button" data-block="blockquote" title="Quote">Quote</button>
              <button type="button" data-command="insertUnorderedList" title="Bulleted list">• List</button>
              <button type="button" data-command="insertOrderedList" title="Numbered list">1. List</button>
              <button type="button" data-link title="Add link">Link</button>
              <button type="button" data-callout title="Insert callout">Callout</button>
            </div>

            <article class="studio-paper">
              <textarea class="studio-title" rows="2" aria-label="Article title" data-title>{entry.data.title}</textarea>
              <p class="studio-byline">Incentive design <span>·</span> <span data-read-time>{entry.data.readTime}</span></p>
              <div class="studio-prose insight-prose" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Article body" data-editor>
                <Content />
              </div>
            </article>

            <footer class="studio-editor-footer">
              <span data-word-count>0 words</span>
              <span>Changes autosave to the cloud</span>
            </footer>
          </section>

          <aside class="studio-inspector" aria-label="Article settings">
            <div class="studio-inspector-heading">
              <div>
                <p class="studio-kicker">Settings</p>
                <h2>Publication details</h2>
              </div>
              <span class="studio-badge">Draft</span>
            </div>

            <label>
              <span>URL slug</span>
              <input type="text" value="open-the-ai" data-slug />
              <small>aispanda.com/<strong data-slug-preview>open-the-ai</strong></small>
            </label>

            <label>
              <span>Excerpt</span>
              <textarea rows="6" data-excerpt>{entry.data.summary}</textarea>
            </label>

            <label>
              <span>Tags</span>
              <input type="text" value="AI strategy, public infrastructure" data-tags />
            </label>

            <div class="studio-checks">
              <p class="studio-kicker">Pre-publish check</p>
              <p><span aria-hidden="true">✓</span> Title and slug present</p>
              <p><span aria-hidden="true">✓</span> Responsive preview available</p>
              <p><span aria-hidden="true">○</span> Media and link validation next</p>
            </div>

            <div class="studio-revisions">
              <p class="studio-kicker">Cloud revisions</p>
              <ol data-revisions>
                <li>No explicit checkpoints yet</li>
              </ol>
            </div>
          </aside>
        </div>

        <section class="studio-publication-receipt" data-publication-receipt hidden>
          <div>
            <p class="studio-kicker">Published release</p>
            <strong>Your article is live.</strong>
            <a data-publication-live target="_blank" rel="noopener noreferrer"></a>
            <small>Release <code data-publication-release></code></small>
          </div>
          <button class="studio-button studio-button-secondary" type="button" data-receipt-unpublish>Unpublish</button>
        </section>

        <section class="studio-content-library" data-content-library hidden>
          <header class="studio-library-header">
            <div>
              <p class="studio-kicker">Content library</p>
              <h1 data-library-title>All content</h1>
              <p data-library-summary>Manage articles and drafts.</p>
            </div>
            <button class="studio-button" type="button" data-new-article>＋ New article</button>
          </header>
          <div class="studio-library-list" data-library-list></div>
        </section>
      </section>
    </main>

    <dialog class="studio-dialog studio-preview-dialog" data-preview-dialog>
      <div class="studio-dialog-header">
        <div>
          <p class="studio-kicker">Production-style rendering</p>
          <h2>Preview</h2>
        </div>
        <div class="studio-dialog-actions">
          <div class="studio-device-toggle" role="group" aria-label="Preview width">
            <button class="is-active" type="button" data-device="desktop">Desktop</button>
            <button type="button" data-device="mobile">Mobile</button>
          </div>
          <button class="studio-icon-button" type="button" data-close-preview aria-label="Close preview">×</button>
        </div>
      </div>
      <div class="studio-preview-stage">
        <iframe class="studio-preview-frame" data-preview-frame title="Production-style article preview" sandbox="allow-scripts allow-same-origin" referrerpolicy="no-referrer"></iframe>
      </div>
    </dialog>

    <dialog class="studio-dialog studio-publish-dialog" data-publish-dialog>
      <form method="dialog">
        <div class="studio-dialog-header">
          <div>
            <p class="studio-kicker">Final review</p>
            <h2>Ready to publish?</h2>
          </div>
          <button class="studio-icon-button" value="cancel" aria-label="Close publication review">×</button>
        </div>

        <div class="studio-publish-summary">
          <div><span>Title</span><strong data-review-title></strong></div>
          <div><span>Destination</span><strong>aispanda.com/<span data-review-slug></span></strong></div>
          <div><span>Timing</span><strong>Right now</strong></div>
          <div><span>Delivery</span><strong>Web only</strong></div>
        </div>

        <p class="studio-publication-warning">
          Publishing creates a permanent release and makes this URL public immediately. Future edits remain private until you publish again.
        </p>

        <div class="studio-publish-actions">
          <button class="studio-button studio-button-secondary" value="cancel">Back to editing</button>
          <button class="studio-button" type="button" data-publish>Publish to AI Spanda</button>
        </div>
      </form>
    </dialog>

    <dialog class="studio-dialog studio-ai-dialog" data-ai-dialog aria-labelledby="studio-ai-title">
      <div class="studio-dialog-header">
        <div>
          <p class="studio-kicker">Writing assistance</p>
          <h2 id="studio-ai-title">AI assist</h2>
        </div>
        <button class="studio-icon-button" type="button" data-close-ai aria-label="Close AI assistance">×</button>
      </div>
      <div class="studio-ai-content">
        <p class="studio-ai-privacy"><strong>You stay in control.</strong> Review exactly what will be shared. Nothing is sent until you explicitly continue.</p>

        <section class="studio-ai-connection" aria-labelledby="studio-ai-connection-title">
          <div class="studio-ai-connection-heading">
            <div>
              <strong id="studio-ai-connection-title">AI connection</strong>
              <span data-ai-connection-state>OpenRouter is not connected</span>
            </div>
            <div class="studio-ai-connection-actions">
              <a class="studio-button studio-button-secondary" href="/ai">Manage AI connections</a>
            </div>
          </div>
          <p data-ai-connection-detail>Connect OpenRouter from your Account page, then return here to use AI assistance.</p>
          <div class="studio-ai-connection-facts" aria-label="How the connection works">
            <span>Your OpenRouter account pays</span>
            <span>Connection lasts this browser tab</span>
            <span>Nothing is sent until you ask</span>
          </div>
          <p class="studio-ai-connection-help">
            You may need OpenRouter credits or eligible free models. Review its limits before generating.
            <a href="https://openrouter.ai/docs/guides/overview/auth/oauth" target="_blank" rel="noopener noreferrer">How the secure connection works ↗</a>
          </p>
        </section>

        <fieldset class="studio-ai-scope">
          <legend>What should be shared?</legend>
          <label><input type="radio" name="ai-scope" value="selection" data-ai-scope-selection /> Selected text</label>
          <label><input type="radio" name="ai-scope" value="article" checked /> Entire article</label>
        </fieldset>

        <label class="studio-ai-field">
          <span>What should the AI do?</span>
          <textarea rows="4" data-ai-instruction>Act as a careful copyeditor. Improve clarity, flow and concision while preserving the author's meaning, factual claims, structure and voice. Do not introduce new facts. Return only the revised content.</textarea>
        </label>

        <label class="studio-ai-field">
          <span>Exact request that will be copied</span>
          <textarea rows="12" readonly data-ai-preview></textarea>
        </label>

        <div class="studio-ai-chrome-note">
          <strong>Using Gemini in Chrome?</strong>
          <span>You can also open Ask Gemini and share this tab. The article title and editor content remain visible and clearly labelled for page-based assistance.</span>
        </div>

        <div class="studio-ai-fallback" data-ai-fallback hidden>
          <strong>Clipboard access was blocked.</strong>
          <span>Use the button below. If copying is still blocked, the request will be selected so you can press Ctrl+C or Cmd+C.</span>
          <button class="studio-button studio-button-secondary" type="button" data-ai-manual-copy>Copy manually</button>
        </div>
      </div>
      <div class="studio-ai-actions">
        <button class="studio-button studio-button-secondary" type="button" data-close-ai>Cancel</button>
        <button class="studio-button" type="button" data-ai-copy-open>Copy AI request &amp; open Gemini</button>
      </div>
    </dialog>

    <dialog class="studio-dialog studio-access-dialog" data-access-dialog>
      <div class="studio-dialog-header">
        <div>
          <p class="studio-kicker">Administration</p>
          <h2>Access requests</h2>
        </div>
        <button class="studio-icon-button" type="button" data-close-access aria-label="Close access requests">×</button>
      </div>
      <p class="studio-access-dialog-summary">Approve only people who should create or publish site content.</p>
      <div class="studio-access-request-list" data-access-request-list></div>
    </dialog>

    <div class="studio-toast" role="status" aria-live="polite" data-toast></div>

    <script>
      import { initializeStudioBackend, type RoleRequest, type StudioDraftRecord } from '@/scripts/studio-firebase';
      import {
        AiActiveConnectionManager,
        AiConnectorRegistry,
        createCloudflareAiGatewayConnector,
        createHuggingFaceConnector,
        createOpenRouterConnector,
      } from '@/scripts/ai-connections';

      const studioBackend = await initializeStudioBackend();
      const aiConnectors = new AiConnectorRegistry([
        createOpenRouterConnector({
          appName: 'AI Spanda Content Studio',
          siteUrl: window.location.origin,
        }),
        createHuggingFaceConnector(),
        createCloudflareAiGatewayConnector(),
      ]);
      const aiConnectionManager = new AiActiveConnectionManager(aiConnectors);
      const openRouterConnector = aiConnectors.get('openrouter');
      const canPublish = studioBackend.role === 'administrator' || studioBackend.role === 'publisher';
      const draftId = new URLSearchParams(window.location.search).get('draft') ?? 'open-the-ai';
      const isNewDraft = draftId !== 'open-the-ai';
      const studio = document.querySelector<HTMLElement>('[data-studio]');
      const title = document.querySelector<HTMLTextAreaElement>('[data-title]');
      const editor = document.querySelector<HTMLElement>('[data-editor]');
      const excerpt = document.querySelector<HTMLTextAreaElement>('[data-excerpt]');
      const slug = document.querySelector<HTMLInputElement>('[data-slug]');
      const tags = document.querySelector<HTMLInputElement>('[data-tags]');
      const saveState = document.querySelector<HTMLElement>('[data-save-state]');
      const wordCount = document.querySelector<HTMLElement>('[data-word-count]');
      const readTime = document.querySelector<HTMLElement>('[data-read-time]');
      const slugPreview = document.querySelector<HTMLElement>('[data-slug-preview]');
      const documentList = document.querySelector<HTMLElement>('[data-document-list]');
      const listHeading = document.querySelector<HTMLElement>('[data-list-heading]');
      const allCount = document.querySelector<HTMLElement>('[data-all-count]');
      const draftCount = document.querySelector<HTMLElement>('[data-draft-count]');
      const publishedCount = document.querySelector<HTMLElement>('[data-published-count]');
      const unpublishedCount = document.querySelector<HTMLElement>('[data-unpublished-count]');
      const archivedCount = document.querySelector<HTMLElement>('[data-archived-count]');
      const persistenceNote = document.querySelector<HTMLElement>('[data-persistence-note]');
      const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
      const editorWorkspace = document.querySelector<HTMLElement>('[data-editor-workspace]');
      const contentLibrary = document.querySelector<HTMLElement>('[data-content-library]');
      const libraryList = document.querySelector<HTMLElement>('[data-library-list]');
      const libraryTitle = document.querySelector<HTMLElement>('[data-library-title]');
      const librarySummary = document.querySelector<HTMLElement>('[data-library-summary]');
      const topbarKicker = document.querySelector<HTMLElement>('[data-topbar-kicker]');
      const editorActions = document.querySelector<HTMLElement>('[data-editor-actions]');
      const revisionsList = document.querySelector<HTMLOListElement>('[data-revisions]');
      const saveMenu = document.querySelector<HTMLDetailsElement>('[data-save-menu]');
      const previewDialog = document.querySelector<HTMLDialogElement>('[data-preview-dialog]');
      const publishDialog = document.querySelector<HTMLDialogElement>('[data-publish-dialog]');
      const previewFrame = document.querySelector<HTMLIFrameElement>('[data-preview-frame]');
      const toast = document.querySelector<HTMLElement>('[data-toast]');
      const publicationReceipt = document.querySelector<HTMLElement>('[data-publication-receipt]');
      const publicationLive = document.querySelector<HTMLAnchorElement>('[data-publication-live]');
      const publicationRelease = document.querySelector<HTMLElement>('[data-publication-release]');
      const receiptUnpublish = document.querySelector<HTMLButtonElement>('[data-receipt-unpublish]');
      const manageAccess = document.querySelector<HTMLButtonElement>('[data-manage-access]');
      const accessDialog = document.querySelector<HTMLDialogElement>('[data-access-dialog]');
      const accessRequestList = document.querySelector<HTMLElement>('[data-access-request-list]');
      const closeAccess = document.querySelector<HTMLButtonElement>('[data-close-access]');
      const openAi = document.querySelector<HTMLButtonElement>('[data-open-ai]');
      const aiDialog = document.querySelector<HTMLDialogElement>('[data-ai-dialog]');
      const aiInstruction = document.querySelector<HTMLTextAreaElement>('[data-ai-instruction]');
      const aiPreview = document.querySelector<HTMLTextAreaElement>('[data-ai-preview]');
      const aiSelectionScope = document.querySelector<HTMLInputElement>('[data-ai-scope-selection]');
      const aiFallback = document.querySelector<HTMLElement>('[data-ai-fallback]');
      const aiCopyOpen = document.querySelector<HTMLButtonElement>('[data-ai-copy-open]');
      const aiManualCopy = document.querySelector<HTMLButtonElement>('[data-ai-manual-copy]');
      const aiConnectionState = document.querySelector<HTMLElement>('[data-ai-connection-state]');
      const aiConnectionDetail = document.querySelector<HTMLElement>('[data-ai-connection-detail]');

      if (!studio || !title || !editor || !excerpt || !slug || !tags || !saveState || !wordCount || !readTime || !slugPreview || !documentList || !listHeading || !allCount || !draftCount || !publishedCount || !unpublishedCount || !archivedCount || !editorWorkspace || !contentLibrary || !libraryList || !libraryTitle || !librarySummary || !topbarKicker || !editorActions || !revisionsList || !saveMenu || !previewDialog || !publishDialog || !previewFrame || !toast || !openAi || !aiDialog || !aiInstruction || !aiPreview || !aiSelectionScope || !aiFallback || !aiCopyOpen || !aiManualCopy || !aiConnectionState || !aiConnectionDetail) {
        throw new Error('Content Studio failed to initialize');
      }

      type Revision = { savedAt: string; title: string };
      type DraftState = {
        title: string;
        body: string;
        excerpt: string;
        slug: string;
        tags: string;
        publicationStatus: 'draft' | 'published' | 'published-with-changes' | 'unpublished';
        publicationReleaseId: string;
        publicationLiveUrl: string;
        updatedAt: string;
        archivedAt?: string;
        revisions: Revision[];
      };
      type ContentFilter = 'all' | 'draft' | 'published' | 'unpublished' | 'archived';
      type DocumentSummary = {
        id: string;
        title: string;
        publicationStatus: DraftState['publicationStatus'];
        updatedAt: string;
        publicPath?: string;
        archivedAt?: string;
      };

      let autosaveTimer = 0;
      let slugEdited = isNewDraft ? false : Boolean(slug.value);
      let publicationStatus: DraftState['publicationStatus'] = 'draft';
      let revisions: Revision[] = [];
      let currentFilter: ContentFilter = 'all';
      let cloudMutationQueue = Promise.resolve();
      let lastKnownUpdatedAt = '1970-01-01T00:00:00.000Z';
      let publicationReleaseId = '';
      let publicationLiveUrl = '';
      let publishIdempotencyKey = '';
      let editVersion = 0;
      let savedVersion = 0;
      let pendingCloudMutations = 0;
      let lastEditorSelection = '';
      const draftRecords = new Map<string, DraftState>();

      if (persistenceNote) {
        persistenceNote.textContent = 'Drafts save to your account and publish directly to the site.';
      }
      document.querySelectorAll<HTMLElement>('[data-open-publish], [data-publish]').forEach((control) => {
        control.hidden = !canPublish;
      });

      const rememberEditorSelection = () => {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0 || selection.isCollapsed) return;
        if (!editor.contains(selection.anchorNode) || !editor.contains(selection.focusNode)) return;
        const selectedText = selection.toString().trim();
        if (selectedText) lastEditorSelection = selectedText;
      };

      document.addEventListener('selectionchange', rememberEditorSelection);

      const selectedAiScope = () =>
        document.querySelector<HTMLInputElement>('input[name="ai-scope"]:checked')?.value ?? 'article';

      const aiSourceText = () => {
        if (selectedAiScope() === 'selection') return lastEditorSelection;
        return [
          `Title: ${title.value.trim() || 'Untitled article'}`,
          excerpt.value.trim() ? `Excerpt: ${excerpt.value.trim()}` : '',
          `Article:\n${editor.innerText.trim()}`,
        ].filter(Boolean).join('\n\n');
      };

      const renderAiRequest = () => {
        const instruction = aiInstruction.value.trim();
        const source = aiSourceText();
        aiPreview.value = [
          instruction,
          '',
          'Content to revise:',
          '--- BEGIN CONTENT ---',
          source,
          '--- END CONTENT ---',
        ].join('\n');
      };

      const formatUsd = (value: number) => new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: 2,
      }).format(value);

      const renderAiConnection = () => {
        const connector = aiConnectionManager.active;
        if (!connector) {
          aiConnectionState.textContent = 'No AI router is connected';
          aiConnectionDetail.textContent = 'Choose a router from your Account page, then return here to use AI assistance.';
          return;
        }

        const connection = connector.status;
        aiConnectionState.textContent = `${connector.descriptor.label} connected`;
        const allowance = typeof connection.limitRemaining === 'number'
          ? ` ${formatUsd(connection.limitRemaining)} remains on this connection's spending limit.`
          : '';
        const label = connection.label ? ` (${connection.label})` : '';
        aiConnectionDetail.textContent = `Connected${label} for this browser tab.${allowance}`;
      };

      const completeAiConnection = async () => {
        try {
          const result = await openRouterConnector.completeConnectionCallback(window.location.href);
          if (!result.handled) return;
          if (result.cleanUrl) window.history.replaceState(null, '', result.cleanUrl);
          if (result.connected) aiConnectionManager.activate('openrouter');
          renderAiConnection();
          if (result.connected) {
            aiDialog.showModal();
            showToast('OpenRouter connected for this browser tab.');
            return;
          }
          aiConnectionState.textContent = 'OpenRouter connection failed';
          aiConnectionDetail.textContent = result.error ?? 'Reconnect and try again.';
          aiDialog.showModal();
          showToast('OpenRouter could not be connected.');
        } catch (error) {
          renderAiConnection();
          aiConnectionState.textContent = 'OpenRouter connection failed';
          aiConnectionDetail.textContent = error instanceof Error ? error.message : 'Reconnect and try again.';
          aiDialog.showModal();
          showToast('OpenRouter could not be connected.');
        }
      };

      const openAiDialog = () => {
        rememberEditorSelection();
        aiSelectionScope.disabled = !lastEditorSelection;
        const articleScope = document.querySelector<HTMLInputElement>('input[name="ai-scope"][value="article"]');
        if (lastEditorSelection) aiSelectionScope.checked = true;
        else if (articleScope) articleScope.checked = true;
        aiFallback.hidden = true;
        renderAiRequest();
        renderAiConnection();
        aiDialog.showModal();
      };

      openAi.addEventListener('click', openAiDialog);
      aiInstruction.addEventListener('input', renderAiRequest);
      document.querySelectorAll<HTMLInputElement>('input[name="ai-scope"]').forEach((scope) => {
        scope.addEventListener('change', renderAiRequest);
      });
      document.querySelectorAll<HTMLButtonElement>('[data-close-ai]').forEach((control) => {
        control.addEventListener('click', () => aiDialog.close());
      });
      aiDialog.addEventListener('click', (event) => {
        if (event.target === aiDialog) aiDialog.close();
      });

      aiCopyOpen.addEventListener('click', async () => {
        renderAiRequest();
        const request = aiPreview.value;
        window.open('https://gemini.google.com/app', '_blank', 'noopener,noreferrer');
        try {
          if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
          await navigator.clipboard.writeText(request);
          aiDialog.close();
          showToast('Copied. Paste with Ctrl+V.');
        } catch {
          aiFallback.hidden = false;
          aiPreview.focus();
          aiPreview.select();
          showToast('Clipboard blocked. Use Copy manually or press Ctrl+C.');
        }
      });

      aiManualCopy.addEventListener('click', () => {
        aiPreview.focus();
        aiPreview.select();
        const copied = document.execCommand('copy');
        showToast(copied ? 'Copied. Paste into Gemini with Ctrl+V.' : 'Request selected. Press Ctrl+C, then paste into Gemini.');
      });

      const roleLabel = (role: RoleRequest['requestedRole']) =>
        role === 'administrator' ? 'Administrator' : role === 'publisher' ? 'Publisher' : 'Author';

      const loadAccessRequests = async () => {
        if (!accessRequestList) return;
        accessRequestList.replaceChildren();
        const loading = document.createElement('p');
        loading.textContent = 'Loading requests…';
        accessRequestList.append(loading);
        try {
          const requests = await studioBackend.listRoleRequests();
          accessRequestList.replaceChildren();
          if (requests.length === 0) {
            const empty = document.createElement('p');
            empty.textContent = 'No pending access requests.';
            accessRequestList.append(empty);
            return;
          }
          for (const request of requests) {
            const row = document.createElement('article');
            row.className = 'studio-access-request-row';
            const identity = document.createElement('div');
            const email = document.createElement('strong');
            email.textContent = request.email;
            const requested = document.createElement('span');
            requested.textContent = `Requests ${roleLabel(request.requestedRole)}`;
            identity.append(email, requested);

            const actions = document.createElement('div');
            const approve = document.createElement('button');
            approve.className = 'studio-button';
            approve.type = 'button';
            approve.textContent = 'Approve';
            const deny = document.createElement('button');
            deny.className = 'studio-button studio-button-secondary';
            deny.type = 'button';
            deny.textContent = 'Decline';
            const review = async (decision: 'approved' | 'denied') => {
              approve.disabled = true;
              deny.disabled = true;
              try {
                await studioBackend.reviewRoleRequest(request, decision);
                await loadAccessRequests();
                showToast(decision === 'approved' ? `${request.email} is now ${roleLabel(request.requestedRole)}.` : 'Request declined.');
              } catch (error) {
                approve.disabled = false;
                deny.disabled = false;
                showToast(error instanceof Error ? error.message : 'The request could not be reviewed.');
              }
            };
            approve.addEventListener('click', () => void review('approved'));
            deny.addEventListener('click', () => void review('denied'));
            actions.append(deny, approve);
            row.append(identity, actions);
            accessRequestList.append(row);
          }
        } catch (error) {
          accessRequestList.replaceChildren();
          const failure = document.createElement('p');
          failure.textContent = error instanceof Error ? error.message : 'Access requests could not be loaded.';
          accessRequestList.append(failure);
        }
      };

      if (studioBackend.role === 'administrator' && manageAccess && accessDialog) {
        manageAccess.hidden = false;
        manageAccess.addEventListener('click', () => {
          accessDialog.showModal();
          void loadAccessRequests();
        });
        closeAccess?.addEventListener('click', () => accessDialog.close());
        accessDialog.addEventListener('click', (event) => {
          if (event.target === accessDialog) accessDialog.close();
        });
      }

      const normalizeSlug = (value: string) => value
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 90);

      const getState = (): DraftState => ({
        title: title.value.trim(),
        body: editor.innerHTML,
        excerpt: excerpt.value.trim(),
        slug: normalizeSlug(slug.value),
        tags: tags.value.trim(),
        publicationStatus,
        publicationReleaseId,
        publicationLiveUrl,
        updatedAt: new Date().toISOString(),
        revisions,
      });

      const statusLabel = (status: DocumentSummary['publicationStatus']) => {
        if (status === 'published') return 'Published';
        if (status === 'published-with-changes') return 'Published · Draft changes';
        if (status === 'unpublished') return 'Unpublished';
        return 'Draft';
      };

      const hasLiveVersion = (item: DocumentSummary) =>
        item.publicationStatus === 'published' || item.publicationStatus === 'published-with-changes';

      const hasDraftWork = (item: DocumentSummary) =>
        item.publicationStatus === 'draft' || item.publicationStatus === 'published-with-changes';

      const parseDraftState = (value: Partial<DraftState> | StudioDraftRecord): DraftState | null => {
        if (
          typeof value.title !== 'string'
          || typeof value.body !== 'string'
          || typeof value.excerpt !== 'string'
          || typeof value.slug !== 'string'
          || typeof value.tags !== 'string'
          || typeof value.updatedAt !== 'string'
          || !Array.isArray(value.revisions)
          || !['draft', 'published', 'published-with-changes', 'unpublished'].includes(String(value.publicationStatus))
        ) return null;
        return {
          ...(value as DraftState),
          publicationReleaseId: typeof value.publicationReleaseId === 'string' ? value.publicationReleaseId : '',
          publicationLiveUrl: typeof value.publicationLiveUrl === 'string' ? value.publicationLiveUrl : '',
          archivedAt: typeof value.archivedAt === 'string' ? value.archivedAt : undefined,
        };
      };

      const loadCloudDrafts = async () => {
        const remoteDrafts = await studioBackend.listDrafts();
        draftRecords.clear();
        for (const [id, record] of Object.entries(remoteDrafts)) {
          const draft = parseDraftState(record);
          if (draft) draftRecords.set(id, draft);
        }
      };

      const readDocumentIndex = (): DocumentSummary[] => {
        const indexed = new Map<string, DocumentSummary>();
        indexed.set('open-the-ai', {
          id: 'open-the-ai',
          title: 'Own the Shared Track. Make AI Providers Compete for the Work.',
          publicationStatus: 'published',
          updatedAt: '2026-08-16T00:00:00.000Z',
          publicPath: '/open-the-ai',
        });

        for (const [id, draft] of draftRecords) {
          const normalizedStatus = id === 'open-the-ai' && draft.publicationStatus === 'draft'
            ? 'published'
            : draft.publicationStatus;
          indexed.set(id, {
            id,
            title: draft.title.trim() || 'Untitled article',
            publicationStatus: normalizedStatus,
            updatedAt: draft.updatedAt,
            archivedAt: draft.archivedAt,
            publicPath: hasLiveVersion({ id, title: draft.title, publicationStatus: normalizedStatus, updatedAt: draft.updatedAt })
              ? id === 'open-the-ai' ? '/open-the-ai' : `/${draft.slug}`
              : undefined,
          });
        }

        return [...indexed.values()].sort((left, right) => right.updatedAt.localeCompare(left.updatedAt));
      };

      const renderDocumentIndex = () => {
        const documents = readDocumentIndex();
        const active = documents.filter((item) => !item.archivedAt);
        const archived = documents.filter((item) => item.archivedAt);
        const drafts = active.filter(hasDraftWork);
        const published = active.filter(hasLiveVersion);
        const unpublished = active.filter((item) => item.publicationStatus === 'unpublished');
        allCount.textContent = String(active.length);
        draftCount.textContent = String(drafts.length);
        publishedCount.textContent = String(published.length);
        unpublishedCount.textContent = String(unpublished.length);
        archivedCount.textContent = String(archived.length);

        const visible = currentFilter === 'draft'
          ? drafts
          : currentFilter === 'published'
            ? published
            : currentFilter === 'unpublished'
              ? unpublished
              : currentFilter === 'archived'
                ? archived
                : active;
        listHeading.textContent = currentFilter === 'draft'
          ? 'Drafts'
          : currentFilter === 'published'
            ? 'Published'
            : currentFilter === 'unpublished'
              ? 'Unpublished'
              : currentFilter === 'archived'
                ? 'Archived'
                : 'All content';
        documentList.replaceChildren();

        if (!visible.length) {
          const empty = document.createElement('p');
          empty.className = 'studio-list-empty';
          empty.textContent = `No ${currentFilter === 'all' ? 'content' : currentFilter} items yet.`;
          documentList.append(empty);
          return;
        }

        for (const item of visible) {
          const card = document.createElement('div');
          card.className = 'studio-document';
          if (item.id === draftId) card.classList.add('is-active');

          const editPath = item.id === 'open-the-ai' ? '/studio' : `/studio?draft=${encodeURIComponent(item.id)}`;
          const itemTitle = document.createElement('a');
          itemTitle.className = 'studio-document-title';
          itemTitle.textContent = item.title;
          if (item.archivedAt) {
            itemTitle.removeAttribute('href');
            itemTitle.setAttribute('aria-label', `${item.title}, archived`);
          } else {
            itemTitle.href = item.publicPath && hasLiveVersion(item) ? item.publicPath : editPath;
            itemTitle.setAttribute('aria-label', item.publicPath && hasLiveVersion(item) ? `Read ${item.title}` : `Edit ${item.title}`);
          }
          const itemMeta = document.createElement('div');
          const itemStatus = document.createElement('small');
          itemStatus.textContent = item.archivedAt ? 'Archived' : statusLabel(item.publicationStatus);
          itemMeta.append(itemStatus);
          if (item.publicPath && hasLiveVersion(item)) {
            const editLink = document.createElement('a');
            editLink.className = 'studio-document-edit';
            editLink.href = editPath;
            editLink.textContent = 'Edit';
            editLink.setAttribute('aria-label', `Edit draft for ${item.title}`);
            itemMeta.append(editLink);
          }
          card.append(itemTitle, itemMeta);
          documentList.append(card);
        }
      };

      const readDocumentState = (item: DocumentSummary): DraftState | null =>
        draftRecords.get(item.id) ?? (item.id === draftId ? getState() : null);

      const unpublishDocument = async (item: DocumentSummary) => {
        const state = readDocumentState(item);
        if (!state) throw new Error('The cloud draft could not be loaded.');
        const result = await studioBackend.unpublishDraft(item.id, state.updatedAt);
        const nextState = { ...state, publicationStatus: 'unpublished' as const, updatedAt: result.updatedAt };
        draftRecords.set(item.id, nextState);
        if (item.id === draftId) {
          publicationStatus = 'unpublished';
          lastKnownUpdatedAt = result.updatedAt;
        }
      };

      const duplicateDocument = async (item: DocumentSummary) => {
        const source = readDocumentState(item);
        if (!source) {
          showToast('The cloud draft could not be duplicated');
          return;
        }
        const duplicateId = window.crypto.randomUUID();
        const duplicateTitle = `Copy of ${item.title}`;
        const duplicate: DraftState = {
          ...source,
          title: duplicateTitle,
          slug: normalizeSlug(duplicateTitle),
          publicationStatus: 'draft',
          publicationReleaseId: '',
          publicationLiveUrl: '',
          updatedAt: new Date().toISOString(),
          revisions: [],
        };
        try {
          await studioBackend.saveDraft(duplicateId, duplicate);
          draftRecords.set(duplicateId, duplicate);
        } catch {
          showToast('The copy could not be saved to the cloud');
          return;
        }
        await navigateAfterSave(`/studio?draft=${encodeURIComponent(duplicateId)}`);
      };

      const archiveDocument = async (item: DocumentSummary) => {
        if (hasLiveVersion(item)) {
          showToast('Unpublish this article before archiving its draft');
          return;
        }
        const confirmed = window.confirm(`Archive the cloud draft “${item.title}”? Its audit history will be preserved.`);
        if (!confirmed) return;
        const state = readDocumentState(item);
        if (!state) {
          showToast('The cloud draft could not be loaded');
          return;
        }
        try {
          const result = await studioBackend.archiveDraft(item.id, state.updatedAt);
          draftRecords.set(item.id, { ...state, archivedAt: result.archivedAt, updatedAt: result.archivedAt });
        } catch {
          showToast('Could not archive the cloud draft; nothing was changed');
          return;
        }
        showToast('Cloud draft archived');
        showContentLibrary('archived');
      };

      const restoreDocument = async (item: DocumentSummary) => {
        const state = readDocumentState(item);
        if (!state?.archivedAt) {
          showToast('The archived cloud draft could not be loaded');
          return;
        }
        try {
          const result = await studioBackend.restoreDraft(item.id, state.updatedAt);
          const { archivedAt: _archivedAt, ...activeState } = state;
          draftRecords.set(item.id, { ...activeState, updatedAt: result.updatedAt });
        } catch (error) {
          showToast(error instanceof Error ? error.message : 'The cloud draft could not be restored');
          return;
        }
        showToast('Cloud draft restored');
        showContentLibrary('all');
      };

      const renderContentLibrary = () => {
        const documents = readDocumentIndex();
        const active = documents.filter((item) => !item.archivedAt);
        const archived = documents.filter((item) => item.archivedAt);
        const visible = currentFilter === 'draft'
          ? active.filter(hasDraftWork)
          : currentFilter === 'published'
            ? active.filter(hasLiveVersion)
            : currentFilter === 'unpublished'
              ? active.filter((item) => item.publicationStatus === 'unpublished')
              : currentFilter === 'archived'
                ? archived
                : active;

        const heading = currentFilter === 'draft'
          ? 'Drafts'
          : currentFilter === 'published'
            ? 'Published'
            : currentFilter === 'unpublished'
              ? 'Unpublished'
              : currentFilter === 'archived'
                ? 'Archived'
                : 'All content';
        libraryTitle.textContent = heading;
        const guidance = currentFilter === 'published'
          ? 'Select a title to read the live article; Edit draft opens unpublished work.'
          : currentFilter === 'draft'
            ? 'Includes unpublished articles and draft changes to published articles.'
            : currentFilter === 'unpublished'
              ? 'These articles are offline and may be republished or deleted.'
              : currentFilter === 'archived'
                ? 'Archived drafts are hidden from editing and publishing until restored.'
              : 'Published titles open the live article; Edit draft opens unpublished work.';
        librarySummary.textContent = `${visible.length} ${visible.length === 1 ? 'item' : 'items'} · ${guidance}`;
        libraryList.replaceChildren();

        if (!visible.length) {
          const empty = document.createElement('div');
          empty.className = 'studio-library-empty';
          empty.innerHTML = '<h2>Nothing here yet</h2><p>Create a new article to begin.</p>';
          libraryList.append(empty);
          return;
        }

        const columns = document.createElement('div');
        columns.className = 'studio-library-columns';
        for (const label of ['Title', 'Status', 'Last updated', 'Actions']) {
          const column = document.createElement('span');
          column.textContent = label;
          columns.append(column);
        }
        libraryList.append(columns);

        for (const item of visible) {
          const row = document.createElement('div');
          row.className = 'studio-library-row';

          const identity = document.createElement('div');
          const itemTitle = document.createElement('h2');
          if (item.publicPath && hasLiveVersion(item)) {
            const readLink = document.createElement('a');
            readLink.className = 'studio-library-title-link';
            readLink.href = item.publicPath;
            readLink.textContent = item.title;
            readLink.setAttribute('aria-label', `Read ${item.title}`);
            itemTitle.append(readLink);
          } else {
            itemTitle.textContent = item.title;
          }
          identity.append(itemTitle);

          const status = document.createElement('span');
          status.className = `studio-library-status is-${item.archivedAt ? 'archived' : item.publicationStatus}`;
          status.textContent = item.archivedAt ? 'Archived' : statusLabel(item.publicationStatus);

          const updated = document.createElement('time');
          updated.dateTime = item.updatedAt;
          updated.textContent = new Date(item.updatedAt).toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' });

          const editLink = document.createElement('a');
          editLink.className = 'studio-library-edit-link';
          editLink.href = item.id === 'open-the-ai' ? '/studio' : `/studio?draft=${encodeURIComponent(item.id)}`;
          editLink.textContent = hasLiveVersion(item) ? 'Edit draft' : 'Edit';
          editLink.setAttribute('aria-label', `${hasLiveVersion(item) ? 'Edit draft for' : 'Edit'} ${item.title}`);

          const actions = document.createElement('div');
          actions.className = 'studio-library-actions';
          const menu = document.createElement('details');
          menu.className = 'studio-row-menu';
          const menuTrigger = document.createElement('summary');
          menuTrigger.textContent = '•••';
          menuTrigger.setAttribute('aria-label', `More actions for ${item.title}`);
          const menuItems = document.createElement('div');
          menuItems.className = 'studio-row-menu-items';

          const addMenuButton = (label: string, handler: () => void | Promise<void>, danger = false) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.textContent = label;
            if (danger) button.className = 'is-danger';
            button.addEventListener('click', () => {
              menu.open = false;
              void handler();
            });
            menuItems.append(button);
          };

          if (item.archivedAt) {
            addMenuButton('Restore draft', () => restoreDocument(item));
          } else {
            addMenuButton('Duplicate', () => duplicateDocument(item));
          }
          if (item.archivedAt) {
            // Restoring is the only mutation available for an archived draft.
          } else if (hasLiveVersion(item)) {
            if (canPublish) {
              addMenuButton('Unpublish', async () => {
                const confirmed = window.confirm(`Unpublish “${item.title}”? Its public URL will stop working, but the cloud draft and release history will be preserved.`);
                if (!confirmed) return;
                try {
                  await unpublishDocument(item);
                  showToast('Article unpublished; the cloud draft was preserved');
                  showContentLibrary('unpublished');
                } catch (error) {
                  showToast(error instanceof Error ? error.message : 'The article could not be unpublished');
                }
              }, true);
            }
          } else if (item.publicationStatus === 'unpublished') {
            if (canPublish) {
              addMenuButton('Republish', () => {
                void navigateAfterSave(item.id === 'open-the-ai' ? '/studio' : `/studio?draft=${encodeURIComponent(item.id)}`);
              });
            }
            addMenuButton('Archive draft', () => archiveDocument(item), true);
          } else {
            addMenuButton('Archive draft', () => archiveDocument(item), true);
          }

          menu.append(menuTrigger, menuItems);
          if (!item.archivedAt) actions.append(editLink);
          actions.append(menu);
          row.append(identity, status, updated, actions);
          libraryList.append(row);
        }
      };

      const showContentLibrary = (filter: ContentFilter) => {
        currentFilter = filter;
        filterButtons.forEach((item) => item.classList.toggle('is-active', item.dataset.filter === filter));
        editorWorkspace.hidden = true;
        contentLibrary.hidden = false;
        editorActions.hidden = true;
        topbarKicker.textContent = 'Content';
        renderDocumentIndex();
        renderContentLibrary();
        saveState.textContent = `${libraryTitle.textContent} · ${librarySummary.textContent?.split(' · ')[0] ?? ''}`;
      };

      const renderRevisions = () => {
        revisionsList.innerHTML = '';
        if (!revisions.length) {
          revisionsList.innerHTML = '<li>No explicit checkpoints yet</li>';
          return;
        }
        for (const revision of revisions.slice().reverse()) {
          const item = document.createElement('li');
          const time = new Date(revision.savedAt).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
          item.textContent = `${time} · ${revision.title || 'Untitled'}`;
          revisionsList.append(item);
        }
      };

      const updateMetrics = () => {
        const words = (editor.innerText.match(/\S+/g) ?? []).length;
        const minutes = Math.max(1, Math.ceil(words / 225));
        wordCount.textContent = `${words.toLocaleString()} words`;
        readTime.textContent = `${minutes} min read`;
        slugPreview.textContent = normalizeSlug(slug.value) || 'untitled';
      };

      const renderPublicationReceipt = () => {
        if (!publicationReceipt || !publicationLive || !publicationRelease) return;
        const visible = hasLiveVersion({
          id: draftId,
          title: title.value,
          publicationStatus,
          updatedAt: lastKnownUpdatedAt,
        }) && Boolean(publicationLiveUrl && publicationReleaseId);
        publicationReceipt.hidden = !visible;
        if (!visible) return;
        publicationLive.href = publicationLiveUrl;
        publicationLive.textContent = publicationLiveUrl;
        publicationRelease.textContent = publicationReleaseId;
      };

      const renderStatus = (override?: string) => {
        renderPublicationReceipt();
        if (draftRecords.get(draftId)?.archivedAt) {
          saveState.textContent = 'Archived · restore to edit';
          return;
        }
        if (override) {
          saveState.textContent = override;
          return;
        }
        if (publicationStatus === 'published') {
          saveState.textContent = 'Published · cloud release active';
        } else if (publicationStatus === 'published-with-changes') {
          saveState.textContent = 'Live article · unpublished changes saved';
        } else if (publicationStatus === 'unpublished') {
          saveState.textContent = 'Unpublished · cloud draft saved';
        } else {
          saveState.textContent = 'Draft · saved to cloud';
        }
      };

      const queueCloudMutation = async (operation: () => Promise<void>) => {
        renderStatus('Saving to cloud…');
        pendingCloudMutations += 1;
        const queued = cloudMutationQueue.then(operation);
        cloudMutationQueue = queued.catch(() => undefined);
        try {
          await queued;
          renderStatus();
          return true;
        } catch (error) {
          renderStatus('Save failed · cloud draft unchanged');
          showToast(error instanceof Error ? error.message : 'The cloud draft could not be saved');
          return false;
        } finally {
          pendingCloudMutations = Math.max(0, pendingCloudMutations - 1);
        }
      };

      const persist = async (checkpoint = false) => {
        const versionToSave = editVersion;
        const previousRevisions = revisions;
        if (checkpoint) {
          revisions = [...revisions, { savedAt: new Date().toISOString(), title: title.value.trim() }].slice(-20);
        }
        const nextState = getState();
        renderRevisions();
        const saved = await queueCloudMutation(async () => {
          const expectedUpdatedAt = draftRecords.get(draftId)?.updatedAt;
          await studioBackend.saveDraft(draftId, nextState, expectedUpdatedAt);
          draftRecords.set(draftId, nextState);
          lastKnownUpdatedAt = nextState.updatedAt;
        });
        if (!saved) {
          revisions = previousRevisions;
          renderRevisions();
          return false;
        }
        savedVersion = Math.max(savedVersion, versionToSave);
        renderDocumentIndex();
        return true;
      };

      const showToast = (message: string) => {
        toast.textContent = message;
        toast.classList.add('is-visible');
        window.setTimeout(() => toast.classList.remove('is-visible'), 2400);
      };

      const hasUnsavedChanges = () => editVersion > savedVersion || pendingCloudMutations > 0;

      const flushPendingSave = async () => {
        window.clearTimeout(autosaveTimer);
        autosaveTimer = 0;
        if (editVersion > savedVersion && !await persist(false)) return false;
        await cloudMutationQueue;
        return !hasUnsavedChanges();
      };

      const navigateAfterSave = async (href: string) => {
        if (!await flushPendingSave()) {
          showToast('Navigation paused because the cloud save did not finish');
          return;
        }
        window.location.assign(href);
      };

      const markChanged = () => {
        if (publicationStatus === 'published') publicationStatus = 'published-with-changes';
        editVersion += 1;
        publishIdempotencyKey = '';
        renderStatus('Saving…');
        updateMetrics();
        window.clearTimeout(autosaveTimer);
        autosaveTimer = window.setTimeout(() => void persist(false), 700);
      };

      try {
        await loadCloudDrafts();
      } catch (error) {
        if (persistenceNote) persistenceNote.textContent = 'Cloud drafts are unavailable. Editing is disabled until the connection recovers.';
        renderStatus('Cloud unavailable · editing disabled');
        title.disabled = true;
        excerpt.disabled = true;
        slug.disabled = true;
        tags.disabled = true;
        editor.contentEditable = 'false';
        editorActions.querySelectorAll<HTMLButtonElement>('button').forEach((button) => { button.disabled = true; });
        throw error;
      }
      const stored = draftRecords.get(draftId);
      if (stored?.archivedAt) {
        showContentLibrary('archived');
        showToast('This draft is archived. Restore it before editing.');
      }
      if (stored) {
        title.value = stored.title;
        editor.innerHTML = stored.body;
        excerpt.value = stored.excerpt;
        slug.value = stored.slug;
        tags.value = stored.tags;
        publicationStatus = stored.publicationStatus;
        publicationReleaseId = stored.publicationReleaseId;
        publicationLiveUrl = stored.publicationLiveUrl;
        revisions = stored.revisions;
        lastKnownUpdatedAt = stored.updatedAt;
      } else if (isNewDraft) {
        title.value = '';
        editor.innerHTML = '<p><br></p>';
        excerpt.value = '';
        slug.value = '';
        tags.value = '';
      }

      if (!isNewDraft && publicationStatus === 'draft') publicationStatus = 'published';

      for (const button of filterButtons) {
        button.addEventListener('click', async () => {
          if (!editorWorkspace.hidden && !await flushPendingSave()) return;
          showContentLibrary((button.dataset.filter ?? 'all') as ContentFilter);
        });
      }

      document.addEventListener('click', (event) => {
        const target = event.target;
        for (const openMenu of document.querySelectorAll<HTMLDetailsElement>('.studio-row-menu[open]')) {
          if (!(target instanceof Node) || !openMenu.contains(target)) openMenu.open = false;
        }
      });

      document.addEventListener('click', (event) => {
        if (!hasUnsavedChanges() || event.defaultPrevented || event.button !== 0) return;
        const target = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
        if (!target || target.target || target.hasAttribute('download')) return;
        const destination = new URL(target.href, window.location.href);
        if (destination.origin !== window.location.origin) return;
        event.preventDefault();
        void navigateAfterSave(destination.toString());
      }, true);

      window.addEventListener('beforeunload', (event) => {
        if (!hasUnsavedChanges()) return;
        event.preventDefault();
        event.returnValue = '';
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const openMenus = [...document.querySelectorAll<HTMLDetailsElement>('.studio-row-menu[open]')];
        for (const openMenu of openMenus) openMenu.open = false;
        openMenus[0]?.querySelector<HTMLElement>('summary')?.focus();
      });

      document.querySelectorAll<HTMLButtonElement>('[data-new-article]').forEach((button) => {
        button.addEventListener('click', async () => {
          const nextDraftId = window.crypto.randomUUID();
          await navigateAfterSave(`/studio?draft=${encodeURIComponent(nextDraftId)}`);
        });
      });

      for (const field of [title, editor, excerpt, tags]) {
        field.addEventListener('input', () => {
          if (field === title && !slugEdited) slug.value = normalizeSlug(title.value);
          markChanged();
        });
      }

      slug.addEventListener('input', () => {
        slugEdited = true;
        slug.value = normalizeSlug(slug.value);
        markChanged();
      });

      document.querySelectorAll<HTMLButtonElement>('[data-command]').forEach((button) => {
        button.addEventListener('click', () => {
          editor.focus();
          document.execCommand(button.dataset.command ?? '', false);
          markChanged();
        });
      });

      document.querySelectorAll<HTMLButtonElement>('[data-block]').forEach((button) => {
        button.addEventListener('click', () => {
          editor.focus();
          document.execCommand('formatBlock', false, button.dataset.block ?? 'p');
          markChanged();
        });
      });

      document.querySelector<HTMLButtonElement>('[data-link]')?.addEventListener('click', () => {
        const input = window.prompt('Link URL (https://, http:// or mailto:)', 'https://');
        if (!input) return;
        let href = '';
        try {
          const candidate = new URL(input);
          if (!['https:', 'http:', 'mailto:'].includes(candidate.protocol)) throw new Error('Unsupported link scheme');
          href = candidate.toString();
        } catch {
          showToast('Use a complete http, https or mailto link');
          return;
        }
        editor.focus();
        document.execCommand('createLink', false, href);
        markChanged();
      });

      document.querySelector<HTMLButtonElement>('[data-callout]')?.addEventListener('click', () => {
        editor.focus();
        document.execCommand('insertHTML', false, '<aside class="studio-callout"><strong>Key point</strong><p>Add the important context here.</p></aside><p><br></p>');
        markChanged();
      });

      document.querySelector<HTMLButtonElement>('[data-save-draft]')?.addEventListener('click', async () => {
        const saved = await persist(true);
        saveMenu.open = false;
        if (saved) showToast('Draft checkpoint saved to the cloud');
      });

      const refreshPreview = async () => {
        previewFrame.srcdoc = await studioBackend.previewDocument(draftId, getState());
      };

      document.querySelector<HTMLButtonElement>('[data-preview]')?.addEventListener('click', async (event) => {
        const previewButton = event.currentTarget as HTMLButtonElement;
        previewButton.disabled = true;
        try {
          await refreshPreview();
          previewDialog.showModal();
        } catch (error) {
          showToast(error instanceof Error ? error.message : 'The safe preview could not be rendered');
        } finally {
          previewButton.disabled = false;
        }
      });

      document.querySelector<HTMLButtonElement>('[data-close-preview]')?.addEventListener('click', () => previewDialog.close());

      document.querySelectorAll<HTMLButtonElement>('[data-device]').forEach((button) => {
        button.addEventListener('click', () => {
          document.querySelectorAll('[data-device]').forEach((item) => item.classList.remove('is-active'));
          button.classList.add('is-active');
          previewFrame.classList.toggle('is-mobile', button.dataset.device === 'mobile');
        });
      });

      document.querySelector<HTMLButtonElement>('[data-open-publish]')?.addEventListener('click', async () => {
        if (!await persist(true)) return;
        saveMenu.open = false;
        const reviewTitle = document.querySelector<HTMLElement>('[data-review-title]');
        const reviewSlug = document.querySelector<HTMLElement>('[data-review-slug]');
        if (reviewTitle) reviewTitle.textContent = title.value.trim() || 'Untitled article';
        if (reviewSlug) reviewSlug.textContent = normalizeSlug(slug.value) || 'untitled';
        publishDialog.showModal();
      });

      document.querySelector<HTMLButtonElement>('[data-publish]')?.addEventListener('click', async (event) => {
        const publishButton = event.currentTarget as HTMLButtonElement;
        publishButton.disabled = true;
        publishButton.textContent = 'Publishing…';
        renderStatus('Publishing to AI Spanda…');
        try {
          await cloudMutationQueue;
          publishIdempotencyKey ||= window.crypto.randomUUID();
          const result = await studioBackend.publishDraft(draftId, lastKnownUpdatedAt, publishIdempotencyKey);
          publicationStatus = 'published';
          publicationReleaseId = result.releaseId;
          publicationLiveUrl = result.liveUrl;
          lastKnownUpdatedAt = result.updatedAt;
          draftRecords.set(draftId, {
            ...getState(),
            publicationStatus: 'published',
            updatedAt: result.updatedAt,
          });
          publishDialog.close();
          renderStatus();
          renderDocumentIndex();
          publishIdempotencyKey = '';
          showToast('Published · the release receipt is shown below');
        } catch (error) {
          renderStatus('Publish failed · cloud draft preserved');
          showToast(error instanceof Error ? error.message : 'The article could not be published');
        } finally {
          publishButton.disabled = false;
          publishButton.textContent = 'Publish to AI Spanda';
        }
      });

      receiptUnpublish?.addEventListener('click', async () => {
        if (!window.confirm('Unpublish this article? Its cloud draft and immutable release history will be preserved.')) return;
        receiptUnpublish.disabled = true;
        try {
          const item = readDocumentIndex().find((document) => document.id === draftId);
          if (!item) throw new Error('The cloud draft could not be loaded.');
          await unpublishDocument(item);
          renderStatus();
          renderDocumentIndex();
          showToast('Article unpublished; the cloud draft was preserved');
        } catch (error) {
          showToast(error instanceof Error ? error.message : 'The article could not be unpublished');
        } finally {
          receiptUnpublish.disabled = false;
        }
      });

      renderAiConnection();
      await completeAiConnection();
      updateMetrics();
      renderRevisions();
      renderStatus();
      if (isNewDraft && !stored) await persist(false);
      else if (!stored?.archivedAt) renderDocumentIndex();
    </script>
  </body>
</html>

