---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AssetCard from '@/components/AssetCard.astro';
import { assets } from '@/data/site';

const assetGroups = [
  {
    id: 'verified-assets',
    eyebrow: 'Start here',
    title: 'Verified starting points',
    description: 'Working proof and reusable assets with recorded verification evidence.',
    assets: assets.filter((asset) => asset.status === 'Live proof' || asset.status === 'Reusable'),
  },
  {
    id: 'pilot-ready-assets',
    eyebrow: 'Evaluate next',
    title: 'Ready for a pilot',
    description: 'Structured assets with defined checks and evaluation work still to complete.',
    assets: assets.filter((asset) => asset.status === 'Pilot-ready'),
  },
  {
    id: 'draft-assets',
    eyebrow: 'Still developing',
    title: 'Draft assets',
    description: 'Useful ideas that remain inspectable without carrying the visual weight of verified assets.',
    assets: assets.filter((asset) => asset.status === 'Draft'),
  },
];
---

<BaseLayout title="Reusable assets" description="Practical AI, architecture and delivery assets designed for evidence-backed reuse.">
  <header class="page-hero shell">
    <p class="eyebrow">Reusable asset library</p>
    <h1>Find a useful starting point.</h1>
    <p class="lede">Choose by outcome and maturity, then inspect the evidence before adapting an asset to your project.</p>
  </header>

  <section class="asset-how shell" aria-labelledby="asset-how-heading">
    <div>
      <p class="eyebrow">How to use an asset</p>
      <h2 id="asset-how-heading">Inspect before you adopt.</h2>
    </div>
    <ol>
      <li><strong>Choose</strong><span>Match the outcome and maturity to the work.</span></li>
      <li><strong>Inspect</strong><span>Open the proof, source, date and boundaries.</span></li>
      <li><strong>Adapt and verify</strong><span>Change the project profile, then test it in context.</span></li>
    </ol>
  </section>

  <section class="asset-catalogue section" aria-label="Asset catalogue">
    <div class="shell asset-groups">
      {assetGroups.map((group) => (
        <section class:list={['asset-group', { 'asset-group-draft': group.id === 'draft-assets' }]} aria-labelledby={group.id}>
          <div class="asset-group-head">
            <div><p class="eyebrow">{group.eyebrow}</p><h2 id={group.id}>{group.title}</h2></div>
            <p>{group.description}</p>
          </div>
          <div class="card-grid">
            {group.assets.map((asset) => <AssetCard asset={asset} featured={asset.status === 'Live proof'} />)}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
