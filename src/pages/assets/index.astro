---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AssetCard from '@/components/AssetCard.astro';
import { assets } from '@/data/site';
---

<BaseLayout title="Reusable assets" description="Practical AI, architecture and delivery assets designed for evidence-backed reuse.">
  <header class="page-hero shell">
    <p class="eyebrow">Reusable asset library</p>
    <h1>Find a useful starting point.</h1>
    <p class="lede">Each asset combines method, documentation, automation, boundaries and proof. Select one asset, load only what you need, and adapt its project profile.</p>
  </header>
  <section class="section" style="padding-top: 1rem">
    <div class="shell card-grid">{assets.map((asset, index) => <AssetCard asset={asset} featured={index === 0} />)}</div>
  </section>
  <section class="section section-alt" aria-labelledby="supportzero-demo-heading">
    <div class="shell section-head">
      <div>
        <p class="eyebrow">Working demonstration</p>
        <h2 id="supportzero-demo-heading">See what plain language delivery can produce.</h2>
      </div>
      <div>
        <p>SupportZero is a fictional support workspace shaped through an agentic workflow. Explore responsive Account, Contact, and Case lists with transparent demo boundaries and no live customer data.</p>
        <p><a class="button" href="/labs/supportzero-case-workspace/index.html">Open the SupportZero workspace</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
