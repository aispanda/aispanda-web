---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AssetCard from '@/components/AssetCard.astro';
import { assets, principles } from '@/data/site';
---

<BaseLayout
  title="AI Spanda"
  description="Personal writing on AI, judgment, and agency — with reusable systems and working proof you can inspect."
>
  <section class="hero hero-atmosphere">
    <img
      class="hero-media"
      src="/social/hero.png"
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="shell hero-copy">
      <p class="brand-signal">AI Spanda</p>
      <h1>Keep agency in the AI age.</h1>
      <p class="lede">Clear thinking for ordinary work and serious decisions — open, right-fit paths over walled gardens and hype.</p>
      <div class="hero-actions">
        <a class="button" href="/principles">See how the work is judged <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="/assets">Explore reusable assets</a>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Who this is for">
    <div class="shell trust-grid">
      <div class="trust-item"><strong>Everyday professionals</strong><span>Survive and evolve with AI without a priesthood.</span></div>
      <div class="trust-item"><strong>Technology leaders</strong><span>Judgment, architecture, cost and evidence — not theatre.</span></div>
      <div class="trust-item"><strong>Builders &amp; policy</strong><span>Reusable patterns and sober open-vs-closed questions.</span></div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <div><p class="eyebrow">Reusable assets</p><h2>Start from something that works.</h2></div>
        <p>These are not slideware. Each asset packages a tested approach, its boundaries, setup, source material and quality checks so another project can adopt it quickly.</p>
      </div>
      <div class="card-grid">
        {assets.map((asset, index) => <AssetCard asset={asset} featured={index === 0} />)}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <div class="section-head">
        <div><p class="eyebrow">How the work is judged</p><h2>Fast does not mean careless.</h2></div>
        <p>AI reduces the cost of producing code and analysis. Good judgment, source ownership and verification become more important—not less.</p>
      </div>
      <div class="principle-grid">
        {principles.slice(0, 4).map((principle) => (
          <article class="principle-card">
            <span class="principle-number">{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.summary}</p>
          </article>
        ))}
      </div>
      <p style="margin-top: 2rem"><a class="text-link" href="/principles">Read all principles <span aria-hidden="true">→</span></a></p>
    </div>
  </section>
</BaseLayout>
