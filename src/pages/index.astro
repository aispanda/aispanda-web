---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AssetCard from '@/components/AssetCard.astro';
import AudienceCard from '@/components/AudienceCard.astro';
import PrincipleCard from '@/components/PrincipleCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { assets, principles } from '@/data/site';
---

<BaseLayout
  title="AI Spanda"
  description="Personal writing on AI, judgment, and agency — with reusable systems and working proof you can inspect."
>
  <section class="hero hero-atmosphere">
    <img
      class="hero-media"
      src="/social/hero.png"
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="shell hero-copy">
      <p class="brand-signal">AI Spanda</p>
      <h1>Keep agency in the AI age.</h1>
      <p class="lede">Clear thinking for ordinary work and serious decisions — open, right-fit paths over walled gardens and hype.</p>
      <div class="hero-actions">
        <a class="button" href="/principles">See how the work is judged <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="/assets">Explore reusable assets</a>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Who this is for">
    <div class="shell trust-grid">
      <AudienceCard variant="strip" label="Everyday professionals">Survive and evolve with AI without a priesthood.</AudienceCard>
      <AudienceCard variant="strip" label="Technology leaders">Judgment, architecture, cost and evidence — not theatre.</AudienceCard>
      <AudienceCard variant="strip" label="Builders & policy">Reusable patterns and sober open-vs-closed questions.</AudienceCard>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading eyebrow="Reusable assets" title="Start from something that works.">
        <p>Each card shows the asset's maturity, recorded verification date and inspectable proof, including gaps that remain open.</p>
      </SectionHeading>
      <div class="card-grid">
        {assets.map((asset, index) => <AssetCard asset={asset} featured={index === 0} />)}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionHeading eyebrow="How the work is judged" title="Fast does not mean careless.">
        <p>AI reduces the cost of producing code and analysis. Good judgment, source ownership and verification become more important—not less.</p>
      </SectionHeading>
      <div class="principle-grid">
        {principles.slice(0, 4).map((principle) => (
          <PrincipleCard number={principle.number} title={principle.title} summary={principle.summary} />
        ))}
      </div>
      <p style="margin-top: 2rem"><a class="text-link" href="/principles">Read all principles <span aria-hidden="true">→</span></a></p>
    </div>
  </section>
</BaseLayout>
