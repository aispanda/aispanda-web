---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AssetCard from '@/components/AssetCard.astro';
import { assets, insights, principles } from '@/data/site';
---

<BaseLayout title="AIspanda" description="Practical AI thinking, reusable systems, and working proof for leaders and builders.">
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">AI strategy · engineering · delivery</p>
        <h1>Turn AI ideas into <em>working proof.</em></h1>
        <p class="lede">Clear thinking for decision-makers. Inspectable architecture for technology leaders. Reusable tools for builders.</p>
        <div class="hero-actions">
          <a class="button" href="/assets">Explore reusable assets <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="/principles">See how we think</a>
        </div>
      </div>
      <div class="proof-orbit" aria-label="From idea to working proof">
        <div class="orbit-line" aria-hidden="true"></div>
        <span class="orbit-card one">Plan with evidence</span>
        <span class="orbit-card two">Build with AI</span>
        <span class="orbit-card three">Verify what matters</span>
        <div class="proof-core">
          <p class="eyebrow">Public learning loop</p>
          <strong>Think.<br />Build.<br />Show.</strong>
          <p>Each asset explains the problem, decisions, implementation, evidence and path to reuse.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Audience pathways">
    <div class="shell trust-grid">
      <div class="trust-item"><strong>Business leaders</strong><span>Value, risk and the smallest credible next step.</span></div>
      <div class="trust-item"><strong>Technology leaders</strong><span>Architecture, governance, cost and scalability.</span></div>
      <div class="trust-item"><strong>Builders</strong><span>Patterns, tools, prompts, code and demonstrations.</span></div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <div><p class="eyebrow">Reusable assets</p><h2>Start from something that works.</h2></div>
        <p>These are not slideware. Each asset packages a tested approach, its boundaries, setup, source material and quality checks so another project can adopt it quickly.</p>
      </div>
      <div class="card-grid">
        {assets.map((asset, index) => <AssetCard asset={asset} featured={index === 0} />)}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <div class="section-head">
        <div><p class="eyebrow">How we build</p><h2>Fast does not mean careless.</h2></div>
        <p>AI reduces the cost of producing code and analysis. Good product judgment, source ownership and verification become more important—not less.</p>
      </div>
      <div class="principle-grid">
        {principles.slice(0, 4).map((principle) => (
          <article class="principle-card">
            <span class="principle-number">{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.summary}</p>
          </article>
        ))}
      </div>
      <p style="margin-top: 2rem"><a class="text-link" href="/principles">Read all principles <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <div><p class="eyebrow">Latest insights</p><h2>What we are learning.</h2></div>
        <p>Short, practical notes drawn from building real systems—not commentary detached from delivery.</p>
      </div>
      <div class="insight-list">
        {insights.map((insight) => (
          <a class="insight-row" href={`/insights/${insight.slug}`}>
            <small>{insight.eyebrow}</small><h3>{insight.title}</h3><span>{insight.readTime} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
