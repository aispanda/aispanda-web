---
const title = 'Connecting Cloudflare · AI Spanda';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <style>
      :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
      body { min-height: 100vh; display: grid; place-items: center; margin: 0; padding: 1rem; box-sizing: border-box; background: #f5f1e8; color: #141820; }
      main { width: min(28rem, 100%); padding: 2rem; box-sizing: border-box; border: 1px solid #d7d9de; border-radius: 1rem; background: white; box-shadow: 0 1.5rem 4rem rgb(14 18 26 / 9%); }
      h1 { margin: 0 0 .7rem; font-size: clamp(1.7rem, 8vw, 2.4rem); line-height: 1.05; }
      p { margin: 0; color: #596273; line-height: 1.55; }
      a { display: inline-block; margin-top: 1rem; color: #1d57ba; font-weight: 800; }
    </style>
  </head>
  <body>
    <main>
      <h1>Finishing your connection…</h1>
      <p data-cloudflare-callback-status>You can return to AI Spanda when this window closes.</p>
      <a href="/ai">Return to AI Tools</a>
    </main>
    <script is:inline>
      (() => {
        const payload = {
          type: 'aispanda:cloudflare-oauth-callback',
          callbackUrl: window.location.href,
        };
        const status = document.querySelector('[data-cloudflare-callback-status]');
        if (window.opener) {
          window.opener.postMessage(payload, window.location.origin);
          if (status) status.textContent = 'Connection received. This window will close automatically.';
          window.setTimeout(() => window.close(), 250);
          return;
        }
        if ('BroadcastChannel' in window) {
          const channel = new BroadcastChannel('aispanda-cloudflare-oauth');
          channel.postMessage(payload);
          channel.close();
          if (status) status.textContent = 'Connection received. Return to your AI Spanda page.';
          return;
        }
        if (status) status.textContent = 'Return to AI Spanda and start the Cloudflare connection again.';
      })();
    </script>
  </body>
</html>
