---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { insights } from '@/data/site';
---

<BaseLayout title="Insights" description="Essays and notes from AI Spanda — published only when ready, not as placeholders.">
  <header class="page-hero shell">
    <p class="eyebrow">Insights</p>
    <h1>Notes when they are ready.</h1>
    <p class="lede">Insights appear here only after they are written from lived learning — not as speculative stubs. Candidates incubate in the seed register until then.</p>
  </header>
  <section class="section" style="padding-top: 1rem">
    <div class="shell">
      {insights.length === 0 ? (
        <div class="content-card">
          <p class="eyebrow">Incubating</p>
          <h2 style="font-size: 1.65rem">No published insights yet.</h2>
          <p>Ideas are parked offline so this site never links to unfinished essays. Meanwhile, read the <a href="/principles">engineering principles</a> or explore <a href="/assets">reusable assets</a>.</p>
        </div>
      ) : (
        <div class="insight-list">
          {insights.map((insight) => (
            <a class="insight-row" href={`/insights/${insight.slug}`}>
              <small>{insight.eyebrow}</small><div><h3>{insight.title}</h3><p>{insight.summary}</p></div><span>{insight.readTime} →</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
