---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { insights } from '@/data/site';

const articles = {
  'ai-changes-the-build-vs-buy-equation': [
    ['The old equation', 'Low-code and packaged software once won mainly because custom development was slow and expensive. AI-assisted delivery changes that cost curve. It can make standard, source-controlled software practical for smaller teams and narrower problems.'],
    ['What still costs money', 'AI does not remove the need to understand users, protect data, choose dependable architecture, test behavior, operate services or maintain ownership. A cheap first draft can become an expensive system if those decisions remain implicit.'],
    ['A better decision', 'Compare options using total effort, flexibility, recurring cost, data ownership, integration fit, operating burden and exit path. Use low-code when its operating model genuinely fits—not merely because writing code used to be difficult.'],
  ],
  'working-proof-earns-trust': [
    ['Claims are easy', 'AI strategy language is abundant. Decision-makers struggle to distinguish practical capability from polished possibility. A small working system makes the distinction visible.'],
    ['Proof reveals the real work', 'A vertical slice exposes data assumptions, integration constraints, response quality, failure handling, security boundaries and cost. It creates a shared object that business, product and engineering people can inspect together.'],
    ['Keep it honest', 'A proof is not production. Label staged data, missing controls, untested scale and deferred operations clearly. Credibility grows when the demonstration shows both capability and its current boundary.'],
  ],
  'design-for-model-change': [
    ['Models will move', 'Model quality, context windows, latency, prices, regions and provider policies change quickly. A product that embeds one provider everywhere turns normal change into expensive reconstruction.'],
    ['Stabilise the contract', 'Give the product a provider-neutral request and response contract. Keep prompts, grounding, evaluations, safety checks, cost limits and fallbacks outside provider-specific application code.'],
    ['Route with evidence', 'Choose defaults by task and measured outcomes, not one global leaderboard. Preserve user choice where it adds value, explain meaningful trade-offs, and re-run evaluations when models or requirements change.'],
  ],
};

export function getStaticPaths() {
  return insights.map((insight) => ({ params: { slug: insight.slug }, props: { insight } }));
}

const { insight } = Astro.props;
const sections = articles[insight.slug as keyof typeof articles];
---

<BaseLayout title={insight.title} description={insight.summary}>
  <article>
    <header class="page-hero shell">
      <p class="eyebrow">{insight.eyebrow} · {insight.readTime}</p>
      <h1>{insight.title}</h1>
      <p class="lede">{insight.summary}</p>
    </header>
    <div class="shell page-grid">
      <aside class="sticky-aside">
        <p class="eyebrow">The short version</p>
        <p>Use AI to change the economics of delivery, then make product judgment, system ownership and verification explicit.</p>
        <a class="text-link" href="/insights">← All insights</a>
      </aside>
      <div class="content-stack">
        {sections.map(([heading, body]) => <section class="content-card"><h2 style="font-size: 1.9rem">{heading}</h2><p>{body}</p></section>)}
      </div>
    </div>
  </article>
</BaseLayout>
