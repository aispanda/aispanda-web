# Public, non-secret Support Zero API endpoint injected into the static demo form at build time.
PUBLIC_SUPPORTZERO_INTAKE_URL=https://replace-with-public-intake-service.example/v1/public/intake/web
PUBLIC_SUPPORTZERO_WORKSPACE_URL=/support-workspace

# Public Firebase web-app configuration. These values identify the app but do not grant data access.
# Firestore security rules and private role records enforce authorization.
PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=replace-with-google-cloud-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-project.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
PUBLIC_FIREBASE_APP_ID=replace-with-web-app-id
PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
